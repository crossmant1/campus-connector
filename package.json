{
  "name": "campus-connector",
  "version": "1.0.0",
  "description": "CampusConnect student networking platform",
  "main": "src/server.js",
  "scripts": {
  "start": "node src/server.js",
  "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
  "dev:api": "nodemon src/server.js",
  "dev:web": "next dev -p 3000",
  "migrate": "node src/database/migrate.js",
  "seed": "node src/database/seed.js",
  "test": "jest --coverage",
  "lint": "eslint ."
},
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "next": "^16.4.6",
    "nodemailer": "^10.5.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.11.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^4.6.10",
    "socket.io": "^4.6.2",
    "socket.io-client": "^4.8.1",
    "uuid": "^14.0.3",
    "winston": "^3.11.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "jest": "^30.5.2",
    "nodemon": "^3.0.2",
    "postcss": "^8.4.49",
    "supertest": "^6.3.3",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  },
  "engines": {
    "node": ">=18"
  }
}
